#include<iostream>
using namespace std;
int main()
{
 int marks[5];
 int sortid;
 cout<<"Enter Marks of five students:\n";
 for(int i=0;i<5;i++)
{
 cout<<"MARKS"<<i+1<<":";
 cin>>marks[i];
}
 for(int i=0;i<5;i++)
{
 for(int j=0;j<5;j++)
{
 if(marks[j]<marks[j+1])
{
 int temp=marks[j];
 marks[j]=marks[j+1];
 marks[j+1]=temp;
}
}
}
cout<<"\nMarks of students in descending order:\n";
for(int i=0;i<5;i++)
{
cout<< marks[i] << " ";
}
cout<<endl;
return 0;
}

